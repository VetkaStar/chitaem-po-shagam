{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:answers": "node tests/answers.mjs && node tests/answers-browser.mjs",
    "dev": "vite --config vite.pages.config.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node tests/answers.mjs && node tests/regression.mjs && node tests/practice-flow.mjs && node tests/text-practice-flow.mjs && node tests/illustrations.mjs && node tests/auto-advance.mjs && node tests/curriculum.mjs && node tests/curriculum-presentation.mjs && node tests/curriculum-execution.mjs && node tests/curriculum-demonstrations.mjs && node tests/curriculum-onboarding.mjs && node tests/curriculum-roadmap.mjs && node tests/curriculum-free-practice.mjs && node tests/free-audio-flow.mjs && node tests/curriculum-completeness.mjs && node tests/curriculum-media.mjs && node tools/verify-curriculum.mjs",
    "typecheck": "tsc --noEmit",
    "build:pages": "vite build --config vite.pages.config.ts",
    "build": "vite build --config vite.pages.config.ts",
    "test:profiles": "node tests/local-profiles.mjs",
    "test:trainer-menu": "node tests/trainer-sections.mjs && node tests/trainer-menu-browser.mjs",
    "test:entry:browser": "node tests/first-entry-browser.mjs && node tests/profile-switch-browser.mjs && node tests/instruction-audio-browser.mjs",
    "test:trainers:browser": "node tests/curriculum-trainers-browser.mjs",
    "test:curriculum": "node tests/curriculum.mjs",
    "test:curriculum:browser": "node tests/curriculum-browser.mjs",
    "test:curriculum:supply": "node tools/verify-curriculum.mjs --run-tests",
    "test:curriculum:onboarding": "node tests/curriculum-onboarding-browser.mjs",
    "test:curriculum:executors": "node tests/curriculum-executors-browser.mjs",
    "test:interaction:browser": "node tests/topic-menu-browser.mjs && node tests/word-bridge-enter-browser.mjs",
    "test:curriculum:roadmap": "node tests/curriculum-roadmap-browser.mjs",
    "test:curriculum:free": "node tests/curriculum-free-browser.mjs && node tests/curriculum-free-app-browser.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
